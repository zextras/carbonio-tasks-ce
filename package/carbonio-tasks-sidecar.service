[Unit]
Description=Carbonio Tasks sidecar proxy
Requires=network-online.target
After=network-online.target
PartOf=carbonio.target

[Service]
User=carbonio-tasks
ExecStart=/usr/bin/consul connect envoy \
    -token-file /etc/carbonio/tasks/service-discover/token \
    -admin-bind localhost:0 \
    -sidecar-for carbonio-tasks
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
[Unit]
Description=Carbonio Tasks daemon
Wants=network.target
Requires=network-online.target
After=network-online.target
PartOf=carbonio.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/opt/zextras/common/bin/java \
  --enable-preview \
  --enable-native-access=ALL-UNNAMED \
  -Djava.net.preferIPv4Stack=true \
  -Xms1024m \
  -Xmx2048m \
  -DTASKS_LOG_LEVEL=warn \
  -jar /usr/share/carbonio/carbonio-tasks.jar
User=carbonio-tasks
Group=carbonio-tasks
Restart=on-failure
RestartSec=15s
TimeoutStartSec=120s
TimeoutStopSec=120s

[Install]
WantedBy=multi-user.target

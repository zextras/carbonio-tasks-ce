<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <licenses>
    <license>
      <comments>Copyright (C) 2026 Zextras, https://www.zextras.com</comments>
      <name>AGPL-3.0-only</name>
    </license>
  </licenses>

  <groupId>com.zextras.carbonio.tasks</groupId>
  <artifactId>carbonio-tasks-ce</artifactId>
  <version>${revision}${changelist}</version>
  <packaging>pom</packaging>

  <name>carbonio-tasks-ce</name>
  <url>https://www.github.com/Zextras/carbonio-tasks-ce</url>

  <modules>
    <module>app</module>
  </modules>

  <properties>
    <!-- Dependencies -->
    <carbonio-user-management-grpc-sdk.version>1.0.3-dev.21.79fc3fa2</carbonio-user-management-grpc-sdk.version>

    <!-- Plugins -->
    <maven-compiler.version>3.13.0</maven-compiler.version>
    <maven-failsafe.version>3.5.5</maven-failsafe.version>
    <maven-jacoco.version>0.8.14</maven-jacoco.version>
    <maven-surefire.version>3.5.6</maven-surefire.version>

    <!-- Other properties -->
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <java-compiler.version>21</java-compiler.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <sonar.dependencyCheck.htmlReportPath>
      ./dependency-check-report.html
    </sonar.dependencyCheck.htmlReportPath>

    <!-- Flags to skip/run tests and the report generation -->
    <skip.integration.tests>true</skip.integration.tests>
    <skip.unit.tests>true</skip.unit.tests>
    <skip.jacoco.full.report.generation>true</skip.jacoco.full.report.generation>

    <!-- CI-friendly versioning -->
    <revision>1.3.0</revision>
    <!-- changelist default is -SNAPSHOT; override with -Dchangelist= for releases -->
    <changelist>-1</changelist>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>flatten-maven-plugin</artifactId>
          <version>1.7.3</version>
          <configuration>
            <updatePomFile>true</updatePomFile>
            <flattenMode>resolveCiFriendliesOnly</flattenMode>
          </configuration>
          <executions>
            <execution>
              <id>flatten</id>
              <!-- Use validate so ${revision}${changelist} is resolved before Quarkus phases -->
              <phase>validate</phase>
              <goals>
                <goal>flatten</goal>
              </goals>
            </execution>
            <execution>
              <id>flatten.clean</id>
              <phase>clean</phase>
              <goals>
                <goal>clean</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${maven-jacoco.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <repositories>
    <repository>
      <id>zextras-java-sdk</id>
      <name>Zextras public maven repo</name>
      <url>https://zextras.jfrog.io/artifactory/java-sdk</url>
    </repository>
  </repositories>

  <distributionManagement>
    <repository>
      <id>artifactory</id>
      <name>Zextras releases</name>
      <url>https://zextras.jfrog.io/artifactory/public-maven-repo</url>
    </repository>
  </distributionManagement>

  <profiles>
    <profile>
      <id>dev</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <changelist>-1</changelist>
      </properties>
    </profile>
    <profile>
      <id>prod</id>
      <properties>
        <changelist>-1</changelist>
      </properties>
    </profile>
  </profiles>

</project>

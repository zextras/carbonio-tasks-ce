<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.zextras.carbonio.quarkus</groupId>
    <artifactId>carbonio-quarkus-extensions-parent</artifactId>
    <version>1.16.0-1</version>
    <relativePath/>
  </parent>

  <licenses>
    <license>
      <comments>Copyright (C) 2026 Zextras, https://www.zextras.com</comments>
      <name>AGPL-3.0-only</name>
    </license>
  </licenses>

  <groupId>com.zextras.carbonio.tasks</groupId>
  <artifactId>carbonio-tasks-ce</artifactId>
  <version>${revision}${changelist}</version>
  <packaging>pom</packaging>

  <name>carbonio-tasks-ce</name>
  <url>https://www.github.com/Zextras/carbonio-tasks-ce</url>

  <modules>
    <module>app</module>
  </modules>

  <properties>
    <!-- Dependencies -->
    <carbonio-user-management-rest-sdk.version>1.3.0-1</carbonio-user-management-rest-sdk.version>

    <!-- Other properties -->
    <sonar.dependencyCheck.htmlReportPath>
      ./dependency-check-report.html
    </sonar.dependencyCheck.htmlReportPath>

    <!-- Flags to skip/run tests and the report generation -->
    <skip.integration.tests>true</skip.integration.tests>
    <skip.unit.tests>true</skip.unit.tests>
    <skip.jacoco.full.report.generation>true</skip.jacoco.full.report.generation>

    <!-- CI-friendly versioning -->
    <revision>1.5.1</revision>
    <!-- changelist default is -SNAPSHOT; override with -Dchangelist= for releases -->
    <changelist>-1</changelist>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>flatten</id>
            <!-- Use validate so ${revision}${changelist} is resolved before Quarkus phases -->
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>dev</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <changelist>-1</changelist>
      </properties>
    </profile>
    <profile>
      <id>prod</id>
      <properties>
        <changelist>-1</changelist>
      </properties>
    </profile>
  </profiles>

</project>
